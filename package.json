{
  "name": "zx-kit-player",
  "private": true,
  "type": "module",
  "scripts": {
    "songs:convert": "node scripts/PT3PSGConverter.mjs",
    "songs:generate": "node scripts/generate-song-library.mjs",
    "songs:validate": "node scripts/validate-songs.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run songs:convert && npm run songs:generate && npm run songs:validate",
    "archive": "npm run build && node scripts/archive-project.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "site": "npm run build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "zx-kit": "0.45.0",
    "prettier": "^3.8.4",
    "vite": "^8.1.3",
    "zip-lib": "1.4.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
