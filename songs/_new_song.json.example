  "ay": {
    "pan": { "A": -0.4, "B": 0, "C": 0.4 }
  },
  "channels": {
    "A": {
      "label": "BASS",
      "patterns": {
        "bassPattern": {
          "notes": "C2 r C2 r",
          "options": { "dur": 180, "vol": 10 }
        }
      },
      "arrangement": [{ "pattern": "bassPattern", "repeat": 8 }]
