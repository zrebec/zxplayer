        }
      },
      "arrangement": [{ "pattern": "leadPattern", "repeat": 8 }]
    },
    "C": {
      "label": "AY EVENTS",
      "patterns": {
        "eventPattern": {
          "options": { "dur": 180, "vol": 8 },
          "events": [
            { "note": "C3" },
            { "note": "r" },
            { "freq": 196, "dur": 360, "envShape": 10, "envCycleDurMs": 90 },
            { "note": "r", "dur": 360 }
          ]
        }
      },
      "arrangement": [{ "pattern": "eventPattern", "repeat": 8 }]
    }
  }
